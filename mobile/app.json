{
  "expo": {
    "name": "LT Counter",
    "slug": "lt-counter",
    "owner": "wcrdesign",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fdf4e3",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pet.nick.ltcounter"
    },
    "android": {
      "package": "pet.nick.ltcounter",
      "adaptiveIcon": {
        "backgroundColor": "#fdf4e3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "LT Counter",
      "shortName": "LT Counter",
      "description": "Table counter for Little Troubles TCG: Cookies, Fights Won and Goals.",
      "lang": "en",
      "themeColor": "#fdf4e3",
      "backgroundColor": "#fdf4e3",
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#fdf4e3"
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/little-troubles-counter"
    },
    "extra": {
      "eas": {
        "projectId": "4b9ca154-9f9f-433f-946e-cdcdf9b911aa"
      }
    }
  }
}
