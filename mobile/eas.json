{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "distribution": "store",
      "credentialsSource": "remote",
      "environment": "production",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "bootstrap": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "alpha": {
      "android": {
        "track": "alpha",
        "releaseStatus": "completed"
      }
    },
    "alpha-draft": {
      "android": {
        "track": "alpha",
        "releaseStatus": "draft"
      }
    },
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
